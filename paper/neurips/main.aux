\newlabel{sec:read}{{5}{4}{Retrieval runs through attention to the written position}{section.5}{}}
\@writefile{toc}{\contentsline {paragraph}{The block removes the value, not the ability to generate.}{4}{section*.3}\protected@file@percent }
\citation{lanham2023faithfulness}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Rate at which the answer follows the edited value under each blocked attention target. Blocking the value's own position collapses following on every model; matched control blocks do not. Error bars are 95 percent bootstrap intervals.}}{5}{figure.2}\protected@file@percent }
\newlabel{fig:knockout}{{2}{5}{Rate at which the answer follows the edited value under each blocked attention target. Blocking the value's own position collapses following on every model; matched control blocks do not. Error bars are 95 percent bootstrap intervals}{figure.2}{}}
