\@writefile{toc}{\contentsline {section}{\numberline {2}Tasks and protocol}{2}{section.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces The edit-and-continue protocol. A correct worked solution is truncated after one edited value line and the model continues. Three interventions target the edited value: changing the visible token, overwriting the hidden state at that position with the state a different value would have produced, and blocking attention from later positions to that position. The readout is whether the final answer follows the planted value.}}{3}{figure.1}\protected@file@percent }
\newlabel{fig:protocol}{{1}{3}{The edit-and-continue protocol. A correct worked solution is truncated after one edited value line and the model continues. Three interventions target the edited value: changing the visible token, overwriting the hidden state at that position with the state a different value would have produced, and blocking attention from later positions to that position. The readout is whether the final answer follows the planted value}{figure.1}{}}
\@writefile{toc}{\contentsline {section}{\numberline {3}The internal workspace holds a few steps at most}{3}{section.3}\protected@file@percent }
\newlabel{sec:nohome}{{3}{3}{The internal workspace holds a few steps at most}{section.3}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4}The written position holds a settable value register}{3}{section.4}\protected@file@percent }
\newlabel{sec:register}{{4}{3}{The written position holds a settable value register}{section.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces State patch on arithmetic chains at ten steps. Rates are conditioned on items where the text edit was followed (first column), so cross-model comparison of later columns should account for that rate. Brackets are 95 percent bootstrap intervals. The two reasoning-distilled models re-solve the problem after their reasoning phase, which raises their random-control reversion; in a logged sample every reverting continuation re-derives from the problem's starting value rather than correcting in place, and re-derivation can only produce the correct answer, so the planted-value column is unaffected.}}{4}{table.1}\protected@file@percent }
\newlabel{tab:patch}{{1}{4}{State patch on arithmetic chains at ten steps. Rates are conditioned on items where the text edit was followed (first column), so cross-model comparison of later columns should account for that rate. Brackets are 95 percent bootstrap intervals. The two reasoning-distilled models re-solve the problem after their reasoning phase, which raises their random-control reversion; in a logged sample every reverting continuation re-derives from the problem's starting value rather than correcting in place, and re-derivation can only produce the correct answer, so the planted-value column is unaffected}{table.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Attention block on arithmetic chains: rate at which the answer follows the edited value. OLMo-2-7B continues this format less reliably (low no-block rate) and shows the same contrast.}}{4}{table.2}\protected@file@percent }
\newlabel{tab:knockout}{{2}{4}{Attention block on arithmetic chains: rate at which the answer follows the edited value. OLMo-2-7B continues this format less reliably (low no-block rate) and shows the same contrast}{table.2}{}}
\@writefile{toc}{\contentsline {paragraph}{The result is a property of written state, not of one template.}{4}{section*.1}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Written positions are independently addressable.}{4}{section*.2}\protected@file@percent }
