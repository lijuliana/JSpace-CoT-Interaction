6 = 246.\n\n## Step 9: Calculate su.\nsu = fa + 79 = 246 + 79 = 325.\n\n## Step 10: Calculate bq.\nbq = su - 23 = 325 - 23 = 302.\n\n## Step 11: Calculate yo.\nyo = bq - 15 = 302 - 15 = 287.\n\n## Step 12: Calculate tu.\ntu = yo - 68 = 287 - 68 = 219.\n\n## Step 13: Calculate gt.\ngt = tu + 15 = 219 + 15 = 234.\n\n## Step 14: Calculate za.\nza = gt - 22 = 234 - 22 = 212.\n\n## Step 15: Calculate qx.\nqx = za + 20 = 212 + 20 = 232.\n\n## Step 16: Calculate jo.\njo = qx + 96 = 232 + 96 = 328.\n\n## Step 17: Calculate qc.\nqc = jo - 54 = 328 - 54 = 274.\n\n## Step 18: Calculate hy.\nhy = qc - 54 = 274 - 54 = 220.\n\n## Step 19: Calculate bd.\nbd = hy - 87 = 220 - 87 = 133.\n\n## Step 20: Calculate it.\nit = bd - 14 = 133 - 14 = 119.\n\n## Step 21: Calculate fr.\nfr = it + 29 = 119 + 29 = 148.\n\n## Step 22: Calculate fc.\nfc = fr + 76 = 148 + 76 = 224.\n\n## Step 23: Calculate in.\nin = fc + 89 = 224 + 89 = 313.\n\n## Step 24: Calculate xn.\nxn = in - 14 = 313 - 14 = 299.\n\n## Step 25: Calculate ta.\nta = xn + 88 = 299 + 88 = 387.\n\n## Step 26: Calculate pi.\npi = ta + 98 = 387 + 98 = 485.\n\n## Step 27: Calculate oj.\noj = pi + 64 = 485 + 64 = 549.\n\n## Step 28: Calculate jp.\njp = oj + 47 = 549 + 47 = 596.\n\n## Step 29: Calculate xa.\nxa = jp - 30 = 596 - 30 = 566.\n\n## Step 30: Calculate bf.\nbf = xa + 47 = 566 + 47 = 613.\n\n## Step 31: Calculate lo.\nlo = bf + 22 = 613 + 22 = 635.\n\n## Step 32: Calculate vk.\nvk = lo + 87 = 635 + 87 = 722.\n\n## Step 33: Calculate vd.\nvd = vk + 12 = 722 + 12 = 734.\n\n## Step 34: Calculate ex.\nex = vd - 79 = 734 - 79 = 655.\n\n## Step 35: Calculate ub.\nub = ex + 45 = 655 + 45 = 700.\n\n## Step 36: Calculate bs.\nbs = ub - 51 = 700 - 51 = 649.\n\n## Step 37: Calculate zj.\nzj = bs - 13 = 649 - 13 = 636.\n\n## Step 38: Calculate ah.\nah = zj + 24 = 636 + 24 = 660.\n\n## Step 39: Calculate sh.\nsh = ah + 66 = 660 + 66 = 726.\n\n## Step 40: Calculate xq.\nxq = sh + 49 = 726 + 49 = 775.\n\n## Step 41: Calculate zx.\nzx = xq + 