\\\n\\text{vl} & = \\text{oq} + 17 = 1180 + 17 = 1197 \\\\\n\\text{rn} & = \\text{vl} - 56 = 1197 - 56 = 1141 \\\\\n\\text{tu} & = \\text{rn} + 41 = 1141 + 41 = 1182 \\\\\n\\text{ko} & = \\text{tu} + 20 = 1182 + 20 = 1202 \\\\\n\\text{bc} & = \\text{ko} + 18 = 1202 + 18 = 1220 \\\\\n\\text{oi} & = \\text{bc} + 15 = 1220 + 15 = 1235 \\\\\n\\text{si} & = \\text{oi} + 57 = 1235 + 57 = 1292 \\\\\n\\text{mo} & = \\text{si} - 26 = 1292 - 26 = 1266 \\\\\n\\text{oz} & = \\text{mo} + 33 = 1266 + 33 = 1299 \\\\\n\\text{qr} & = \\text{oz} + 59 = 1299 + 59 = 1358 \\\\\n\\text{us} & = \\text{qr} + 41 = 1358 + 41 = 1399 \\\\\n\\text{gm} & = \\text{us} + 14 = 1399 + 14 = 1413 \\\\\n\\text{wb} & = \\text{gm} + 54 = 1413 + 54 = 1467 \\\\\n\\text{gz} & = \\text{wb} + 46 = 1467 + 46 = 1513 \\\\\n\\text{jh} & = \\text{gz} - 72 = 1513 - 72 = 1441 \\\\\n\\text{jc} & = \\text{jh} + 49 = 1441 + 49 = 1490 \\\\\n\\text{ay} & = \\text{jc} - 80 = 1490 - 80 = 1410 \\\\\n\\text{gy} & = \\text{ay} + 43 = 1410 + 43 = 1453 \\\\\n\\text{mu} & = \\text{gy} - 89 = 1453 - 89 = 1364 \\\\\n\\text{gv} & = \\text{mu} + 70 = 1364 + 70 = 1434 \\\\\n\\text{fj} & = \\text{gv} + 21 = 1434 + 21 = 1455 \\\\\n\\text{uc} & = \\text{fj} - 23 = 1455 - 23 = 1432 \\\\\n\\text{oe} & = \\text{uc} + 67 = 1432 + 67 = 1499 \\\\\n\\text{ug} & = \\text{oe} + 76 = 1499 + 76 = 1575 \\\\\n\\text{he} & = \\text{ug} - 72 = 1575 - 72 = 1503 \\\\\n\\text{ro} & = \\text{he} - 28 = 1503 - 28 = 1475 \\\\\n\\text{qi} & = \\text{ro} - 43 = 1475 - 43 = 1432 \\\\\n\\text{ur} & = \\text{qi} - 87 = 1432 - 87 = 1345 \\\\\n\\text{xj} & = \\text{ur} - 93 = 1345 - 93 = 1252 \\\\\n\\text{ny} & = \\text{xj} + 99 = 1252 + 99 = 1351 \\\\\n\\text{og} & = \\text{ny} + 95 = 1351 + 95 = 1446 \\\\\n\\text{gj} & = \\text{og} + 42 = 1446 + 42 = 1488 \\\\\n\\text{pt} & = \\text{gj} + 26 = 1488 + 26 = 1514 \\\\\n\\text{se} & = \\text{pt} + 31 = 1514 + 31 = 1545 \\\\\n\\text{zu} & = \\text{se} + 68 = 1545 + 68 = 1613 \\\\\n\\text{ux} & = \\text{zu} + 75 = 1613 + 75 = 1688 \\\\\n\\text{jv} & = \\text{ux} + 41 = 1688 + 41 = 1729 \\\\\n\\text{th} & = \\text{jv} + 66 = 1729 + 66 = 1795 \\\\\n\\text{kz} & = \\text{th} + 42 = 1795 + 42 = 1837 \\\\\n\\text{tq} & = \\text{kz} + 85 = 1837 + 85 = 1922 \\\\\n\\text{ts} & = \\text{tq} + 89 = 1922 + 89 = 2011 \\\\\n\\text{uh} & = \\text{ts} - 42 = 2011 - 42 = 1969 \\\\\n\\text{rx} & = \\text{uh} - 45 = 1969 - 45 = 1924 \\\\\n\\text{nv} & = \\text{rx} + 29 = 1924 + 29 = 1953 \\\\\n\\text{wj} & = \\text{nv} + 59 = 1953 + 59 = 2012 \\\\\n\\text{vy} & = \\text{wj} - 30 = 2012 - 30 = 1982 \\\\\n\\end{align*}\n\\]\n\nThe value of \\(\\text{vy}\\) is \\(\\boxed{1982}\\)."}
