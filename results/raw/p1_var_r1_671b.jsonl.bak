p by step:\n\n\\[\n\\begin{align*}\npe &= 211, \\\\\nqo &= pe - 80 = 211 - 80 = 131, \\\\\nbp &= qo - 25 = 131 - 25 = 106, \\\\\nkf &= bp - 79 = 106 - 79 = 27, \\\\\nud &= kf + 87 = 27 + 87 = 114, \\\\\ntd &= ud - 66 = 114 - 66 = 48, \\\\\npy &= td + 86 = 48 + 86 = 134, \\\\\nly &= py - 50 = 134 - 50 = 84, \\\\\nsu &= ly + 47 = 84 + 47 = 131, \\\\\noc &= su + 34 = 131 + 34 = 165, \\\\\nwz &= oc + 14 = 165 + 14 = 179, \\\\\nip &= wz - 70 = 179 - 70 = 109, \\\\\ntw &= ip + 21 = 109 + 21 = 130, \\\\\nfm &= tw + 29 = 130 + 29 = 159, \\\\\nlc &= fm + 20 = 159 + 20 = 179, \\\\\nfn &= lc - 77 = 179 - 77 = 102, \\\\\ndt &= fn - 76 = 102 - 76 = 26, \\\\\nyj &= dt + 37 = 26 + 37 = 63, \\\\\njw &= yj - 84 = 63 - 84 = -21, \\\\\nuz &= jw - 67 = -21 - 67 = -88, \\\\\nxs &= uz - 94 = -88 - 94 = -182, \\\\\nfu &= xs - 20 = -182 - 20 = -202, \\\\\nmf &= fu - 88 = -202 - 88 = -290, \\\\\ndx &= mf + 72 = -290 + 72 = -218, \\\\\ncx &= dx - 34 = -218 - 34 = -252, \\\\\nna &= cx + 12 = -252 + 12 = -240, \\\\\nsp &= na - 24 = -240 - 24 = -264, \\\\\nwb &= sp + 57 = -264 + 57 = -207, \\\\\ndz &= wb + 52 = -207 + 52 = -155, \\\\\nny &= dz - 17 = -155 - 17 = -172, \\\\\nrc &= ny + 28 = -172 + 28 = -144, \\\\\nml &= rc + 15 = -144 + 15 = -129, \\\\\nyb &= ml + 13 = -129 + 13 = -116, \\\\\nzf &= yb + 91 = -116 + 91 = -25, \\\\\nib &= zf + 87 = -25 + 87 = 62, \\\\\nvt &= ib + 60 = 62 + 60 = 122, \\\\\nrl &= vt + 57 = 122 + 57 = 179, \\\\\nun &= rl + 14 = 179 + 14 = 193, \\\\\nkg &= un + 34 = 193 + 34 = 227, \\\\\ncl &= kg + 25 = 227 + 25 = 252, \\\\\nvp &= cl - 36 = 252 - 36 = 216, \\\\\nao &= vp + 96 = 216 + 96 = 312, \\\\\ndr &= ao + 79 = 312 + 79 = 391, \\\\\nps &= dr - 89 = 391 - 89 = 302, \\\\\nyq &= ps + 43 = 302 + 43 = 345, \\\\\nab &= yq + 38 = 345 + 38 = 383, \\\\\nyc &= ab + 92 = 383 + 92 = 475, \\\\\ntl &= yc - 54 = 475 - 54 = 421, \\\\\nnd &= tl - 33 = 421 - 33 = 388, \\\\\njp &= nd + 74 = 388 + 74 = 462, \\\\\nmv &= jp - 15 = 462 - 15 = 447, \\\\\ncm &= mv + 99 = 447 + 99 = 546, \