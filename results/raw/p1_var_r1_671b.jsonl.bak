ep-by-step:\n\n\\[\n\\begin{align*}\n\\text{ef} & = 225 \\\\\n\\text{yg} & = \\text{ef} - 13 = 225 - 13 = 212 \\\\\n\\text{zr} & = \\text{yg} + 45 = 212 + 45 = 257 \\\\\n\\text{ut} & = \\text{zr} + 58 = 257 + 58 = 315 \\\\\n\\text{js} & = \\text{ut} - 84 = 315 - 84 = 231 \\\\\n\\text{kr} & = \\text{js} - 87 = 231 - 87 = 144 \\\\\n\\text{kb} & = \\text{kr} + 92 = 144 + 92 = 236 \\\\\n\\text{lm} & = \\text{kb} + 84 = 236 + 84 = 320 \\\\\n\\text{cw} & = \\text{lm} - 33 = 320 - 33 = 287 \\\\\n\\text{zy} & = \\text{cw} + 72 = 287 + 72 = 359 \\\\\n\\text{rs} & = \\text{zy} + 44 = 359 + 44 = 403 \\\\\n\\text{ly} & = \\text{rs} - 89 = 403 - 89 = 314 \\\\\n\\text{sj} & = \\text{ly} + 72 = 314 + 72 = 386 \\\\\n\\text{pq} & = \\text{sj} - 74 = 386 - 74 = 312 \\\\\n\\text{pn} & = \\text{pq} - 23 = 312 - 23 = 289 \\\\\n\\text{er} & = \\text{pn} + 21 = 289 + 21 = 310 \\\\\n\\text{kj} & = \\text{er} - 45 = 310 - 45 = 265 \\\\\n\\text{iu} & = \\text{kj} + 13 = 265 + 13 = 278 \\\\\n\\text{ml} & = \\text{iu} + 62 = 278 + 62 = 340 \\\\\n\\text{oc} & = \\text{ml} + 97 = 340 + 97 = 437 \\\\\n\\text{kg} & = \\text{oc} + 64 = 437 + 64 = 501 \\\\\n\\text{of} & = \\text{kg} - 97 = 501 - 97 = 404 \\\\\n\\text{yx} & = \\text{of} + 78 = 404 + 78 = 482 \\\\\n\\text{yw} & = \\text{yx} - 68 = 482 - 68 = 414 \\\\\n\\text{ui} & = \\text{yw} - 72 = 414 - 72 = 342 \\\\\n\\text{fx} & = \\text{ui} - 65 = 342 - 65 = 277 \\\\\n\\text{gi} & = \\text{fx} - 86 = 277 - 86 = 191 \\\\\n\\text{vs} & = \\text{gi} + 42 = 191 + 42 = 233 \\\\\n\\text{kv} & = \\text{vs} - 60 = 233 - 60 = 173 \\\\\n\\text{gm} & = \\text{kv} + 67 = 173 + 67 = 240 \\\\\n\\text{ak} & = \\text{gm} - 18 = 240 - 18 = 222 \\\\\n\\text{ct} & = \\text{ak} + 72 = 222 + 72 = 294 \\\\\n\\end{align*}\n\\]\n\nThe value of \\(\\text{ct}\\) is \\(\\boxed{294}\\)."}
